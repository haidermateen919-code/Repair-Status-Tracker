# ---------------------------------------------------------------------------
# Repair Status Tracker — environment variables
# Copy to `.env` (or run `npm run setup`, which generates one for you).
# Never commit `.env`. On Vercel, set these in Project → Settings → Environment.
# ---------------------------------------------------------------------------

# --- Required ---------------------------------------------------------------
# Session signing secret (Auth.js). Generate: openssl rand -base64 32
AUTH_SECRET=

# --- Database ---------------------------------------------------------------
# Leave DATABASE_URL empty for local development: the app then runs an embedded
# PostgreSQL (PGlite) in ./.data/pglite. In production set it to a real Postgres
# connection string, e.g. Neon: postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=

# --- Seed data (used by `npm run db:seed` only) ------------------------------
SEED_OWNER_EMAIL=owner@shop.pk
SEED_OWNER_PASSWORD=
SEED_OWNER_NAME=Shop Owner

# --- Shop profile (shown to customers on the public status page) -------------
SHOP_NAME=
SHOP_PHONE=
SHOP_WHATSAPP=
SHOP_ADDRESS=
SHOP_TIMINGS=9am–8pm, Monday closed

# --- Optional ---------------------------------------------------------------
# Absolute base URL used for public links, e.g. https://tracker.example.com.
# Leave empty to derive it from the incoming request (works on Vercel).
APP_BASE_URL=
