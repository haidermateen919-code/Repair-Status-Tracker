{
  "name": "repair-status-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Private repair-status links for a single appliance repair shop.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e.mjs",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "demo:seed": "tsx scripts/demo.ts",
    "db:purge": "tsx scripts/purge-old-data.ts",
    "db:reset-password": "tsx scripts/reset-password.ts",
    "setup": "node scripts/setup-env.mjs && npm run db:migrate && npm run db:seed",
    "icons": "node scripts/generate-icons.mjs",
    "preview": "node scripts/preview.mjs",
    "provision": "tsx scripts/provision.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@node-rs/argon2": "^2.2.2",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.62.0",
    "next": "^15.5.28",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "postcss": "^8.5.32"
  }
}
